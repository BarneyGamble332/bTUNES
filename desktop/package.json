{
  "name": "btunes",
  "productName": "bTUNES",
  "version": "1.0.0",
  "description": "Musik- und Podcast-Player im Plattenspieler-Look",
  "author": {
    "name": "Bernhard",
    "email": "btunes@users.noreply.github.com"
  },
  "homepage": "https://github.com/BarneyGamble332/bTUNES",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage rpm --publish never"
  },
  "dependencies": {
    "music-metadata": "^12.3.5"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "de.bernhard.btunes",
    "productName": "bTUNES",
    "artifactName": "bTUNES-${version}.${ext}",
    "files": [
      "main.mjs",
      "lib.mjs",
      "preload.cjs",
      "app/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "rpm"
      ],
      "category": "AudioVideo;Audio;Player",
      "icon": "build/icon.png",
      "executableName": "btunes",
      "synopsis": "Musik- und Podcast-Player im Plattenspieler-Look",
      "desktop": {
        "entry": {
          "Name": "bTUNES",
          "Comment": "Musik- und Podcast-Player",
          "StartupWMClass": "bTUNES"
        }
      }
    },
    "asarUnpack": [
      "app/asr/**"
    ]
  }
}
