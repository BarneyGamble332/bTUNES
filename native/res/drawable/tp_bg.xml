<?xml version="1.0" encoding="utf-8"?>
<!-- Gehäuse des Taschen-Players: orangefarbenes Alu -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle">
        <gradient android:angle="300" android:startColor="#FFD98243" android:centerColor="#FFB25A23" android:endColor="#FF83401A" />
        <corners android:radius="24dp" />
    </shape></item>
    <item><shape android:shape="rectangle">
        <gradient android:angle="270" android:startColor="#2EFFFFFF" android:centerColor="#00FFFFFF" android:endColor="#22000000" />
        <corners android:radius="24dp" />
        <stroke android:width="1dp" android:color="#40FFFFFF" />
    </shape></item>
</layer-list>
